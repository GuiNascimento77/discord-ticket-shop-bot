# Copie este arquivo para .env e preencha os valores.
# O arquivo .env NUNCA deve ir para o GitHub (ja esta no .gitignore).

# Obrigatorio: token do bot (Discord Developer Portal > Bot > Reset Token)
DISCORD_TOKEN=cole-seu-token-aqui

# Recomendado: ID do seu servidor (deixa os comandos / disponiveis na hora).
# Para pegar: Discord > Configuracoes do usuario > Avancado > Modo desenvolvedor,
# depois clique com o botao direito no servidor > Copiar ID do servidor.
GUILD_ID=

# Opcional: cargo que pode atender/confirmar pedidos (ex.: "Equipe", "Staff").
# Sem isso, o bot usa a permissao "Gerenciar Canais" como criterio de equipe.
STAFF_ROLE_ID=

# Opcional: categoria onde os canais de ticket sao criados.
CATEGORIA_ID=

# Opcional: caminho do arquivo do banco de dados.
DB_PATH=dados/bot.db
